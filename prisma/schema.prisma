// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// FAZA 1: YADRO INFRATUZILMA (HR, Roles, Users)
// -----------------------------------------------------------------------------

model Department {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  headUserId  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
}

model Role {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  code           String   @unique // e.g. ADMIN, DIRECTOR, QC, KITCHEN
  canExportExcel Boolean  @default(false)
  permissions    String?  // JSON string for ABAC policies
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users          User[]
}

model User {
  id               Int      @id @default(autoincrement())
  name             String
  username         String   @unique
  password         String
  role             String   @default("OPERATOR") // Backwards compatibility
  roleId           Int?
  departmentId     Int?
  medicalClearance Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  roleRelation     Role?        @relation(fields: [roleId], references: [id])
  department       Department?  @relation(fields: [departmentId], references: [id])
  
  inspections      Inspection[]
  logs             Log[]
  auditLogs        AuditLog[]
  exportLogs       ExportLog[]
  medicalRecords   MedicalRecord[]
  ticketsReported  MaintenanceTicket[] @relation("ReportedTickets")
  ticketsAssigned  MaintenanceTicket[] @relation("AssignedTickets")
  degustations     DegustationLog[]
  temperatureLogs  TemperatureLog[]
  processQCLogs    ProcessQCLog[]
  disinfectionLogs DisinfectionLog[]
  calibrationLogs  CalibrationLog[]
  fsscQcLogs       FsscQcLog[]
  receivingLogs    ReceivingLog[]
  dailyQcChecklists DailyQCChecklist[]
}

model MedicalRecord {
  id          Int      @id @default(autoincrement())
  userId      Int
  validUntil  DateTime
  documentUrl String?
  isValid     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id              Int      @id @default(autoincrement())
  tableName       String
  operation       String   // INSERT, UPDATE, DELETE
  oldValues       String?  // JSON string
  newValues       String?  // JSON string
  changedByUserId Int?
  createdAt       DateTime @default(now())

  user            User?    @relation(fields: [changedByUserId], references: [id])
}

model ExportLog {
  id            Int      @id @default(autoincrement())
  userId        Int
  dataExported  String
  exportedAt    DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])
}

// -----------------------------------------------------------------------------
// FAZA 2: OMBOR VA LOGISTIKA (WMS, FEFO, OCC)
// -----------------------------------------------------------------------------

model Warehouse {
  id          Int      @id @default(autoincrement())
  name        String
  type        String   // RAW, FINISHED, COLD
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  zones       WarehouseZone[]
  batches     InventoryBatch[]
}

model WarehouseZone {
  id          Int      @id @default(autoincrement())
  warehouseId Int
  name        String   // e.g. A-qator, B-javon
  
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  batches     InventoryBatch[]
}

model InventoryBatch {
  id             Int      @id @default(autoincrement())
  productId      Int
  batchNumber    String   @unique
  warehouseId    Int?
  zoneId         Int?
  quantity       Float
  cost           Float?
  receivedAt     DateTime @default(now())
  expirationDate DateTime?
  qcStatus       String   @default("PENDING") // PENDING, APPROVED, REJECTED, QUARANTINE
  version        Int      @default(1) // For Optimistic Concurrency Control
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id])
  warehouse      Warehouse?      @relation(fields: [warehouseId], references: [id])
  zone           WarehouseZone?  @relation(fields: [zoneId], references: [id])
  transactions   InventoryTransaction[]
  degustations   DegustationLog[]
  transfers      StockTransfer[]
}

model InventoryTransaction {
  id              Int      @id @default(autoincrement())
  batchId         Int
  transactionType String   // IN, OUT, SCRAP, TRANSFER
  quantity        Float
  userId          Int?
  referenceDocId  String?
  createdAt       DateTime @default(now())

  batch           InventoryBatch @relation(fields: [batchId], references: [id])
}

model StockTransfer {
  id                Int      @id @default(autoincrement())
  transferNumber    String   @unique
  productId         Int
  batchId           Int?
  sourceLocation    String   @default("SKLAD") // SKLAD, ZAGOTOVKA, OSHXONA, COLD_STORAGE
  targetLocation    String   // ZAGOTOVKA, OSHXONA, COLD_STORAGE, SKLAD
  issuedQuantity    Float    // Sklad chiqargan miqdor (masalan, 30 kg)
  issuedUnit        String   @default("kg")
  issuedById        Int?
  issuedByName      String?  // Sklad xodimi ismi
  issuedAt          DateTime @default(now())
  
  receivedQuantity  Float?   // Oshxona / Zagotovka tortib olgan miqdor (masalan, 28.5 kg)
  receivedById      Int?
  receivedByName    String?  // Oshpaz / Zagotovkachi ismi
  receivedAt        DateTime?
  
  discrepancy       Float?   // Farq (masalan, 1.5 kg)
  discrepancyReason String?  // Sabab: Masalan "Go'sht suvi oqishi", "Qirqish isrofi"
  status            String   @default("IN_TRANSIT") // IN_TRANSIT, ACCEPTED, DISCREPANCY, REJECTED
  
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product           Product         @relation(fields: [productId], references: [id])
  batch             InventoryBatch? @relation(fields: [batchId], references: [id])

  @@index([transferNumber])
  @@index([productId])
  @@index([status])
  @@index([sourceLocation])
  @@index([targetLocation])
}

// -----------------------------------------------------------------------------
// FAZA 3: ISHLAB CHIQARISH VA SIFAT NAZORATI (BOM, Recipe, QA)
// -----------------------------------------------------------------------------

model Recipe {
  id              Int      @id @default(autoincrement())
  outputProductId Int
  version         Int      @default(1)
  baseYieldQty    Float
  technologistId  Int?
  isApproved      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  outputProduct   Product            @relation(fields: [outputProductId], references: [id])
  ingredients     RecipeIngredient[]
  orders          ProductionOrder[]
}

model RecipeIngredient {
  id               Int      @id @default(autoincrement())
  recipeId         Int
  inputProductId   Int
  requiredQty      Float
  tolerancePercent Float?   @default(0)
  isSubstitutable  Boolean  @default(false)

  recipe           Recipe   @relation(fields: [recipeId], references: [id])
  inputProduct     Product  @relation("RecipeInputs", fields: [inputProductId], references: [id])
}

model ProductionOrder {
  id                Int      @id @default(autoincrement())
  orderNumber       String?  @unique
  recipeId          Int
  plannedOutput     Float
  actualOutput      Float?
  yieldPercent      Float?   // Chiqish normasi foizi (masalan 94.5%)
  rawBatchCode      String?  // Xomashyo partiya kodi (Traceability)
  finishedBatchCode String?  // Tayyor mahsulot partiya kodi
  lineName          String?  // Masalan: "1-Liniya: Salat Yuvish va Kesish"
  supervisorName    String?  // Sex nazoratchisi FIO
  status            String   @default("COMPLETED") // PLANNED, IN_PROGRESS, QC_CHECK, COMPLETED
  notes             String?
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  recipe            Recipe   @relation(fields: [recipeId], references: [id])
}

model DefectLog {
  id            Int      @id @default(autoincrement())
  defectNumber  String   @unique
  productId     Int
  batchNumber   String?
  supplierId    Int?
  location      String   @default("INSPECTION") // INSPECTION, WAREHOUSE, WORKSHOP, KITCHEN
  defectType    String   // ROTTEN, FOREIGN_OBJECT, TEMPERATURE_ABUSE, EXPIRED, MECHANICAL_DAMAGE, PACKAGING_DEFECT, OTHER
  quantity      Float
  unit          String   @default("kg")
  estimatedCost Float?
  actionTaken   String   // RETURN_TO_SUPPLIER, SCRAP_DISPOSAL, REWORK_RE_SORT, DOWNGRADE
  reason        String
  responsible   String?
  inspectorId   Int?
  status        String   @default("RECORDED") // RECORDED, APPROVED, DISPOSED, REIMBURSED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product   @relation(fields: [productId], references: [id])
  supplier      Supplier? @relation(fields: [supplierId], references: [id])

  @@index([productId])
  @@index([supplierId])
  @@index([location])
}

model DegustationLog {
  id             Int      @id @default(autoincrement())
  batchId        Int?
  vannaNo        Int
  inspectionDate DateTime @default(now())
  appearanceOk   Boolean
  smellOk        Boolean
  tasteOk        Boolean
  moistureOk     Boolean
  notes          String?
  qcInspectorId  Int
  createdAt      DateTime @default(now())

  batch          InventoryBatch? @relation(fields: [batchId], references: [id])
  qcInspector    User            @relation(fields: [qcInspectorId], references: [id])
}

// -----------------------------------------------------------------------------
// MAVJUD MODELLAR (Biroz kengaytirilgan holda)
// -----------------------------------------------------------------------------

model Product {
  id                 Int      @id @default(autoincrement())
  name               String
  code               String?  @unique
  barcode            String?  @unique
  category           String?
  unit               String   @default("kg")
  defaultTemperature String?
  minTemperature     Float?
  maxTemperature     Float?
  defaultPackaging   String?
  defaultConclusion  String?
  storageCondition   String?
  shelfLife          String?
  shelfLifeDays      Int?
  gost               String?
  description        String?
  allergenInfo       String?
  type               String   @default("RAW_MATERIAL") // RAW_MATERIAL, KITCHEN, FINISHED_GOOD
  isPerishable       Boolean  @default(true)
  minStockLevel      Float?   @default(0) // Svetofor tizimi uchun (Sariq/Qizil)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  inspections      Inspection[]
  orders           Order[]
  specifications   Specification[]
  batches          InventoryBatch[]
  recipesWhereOutput Recipe[]
  recipesWhereInput  RecipeIngredient[] @relation("RecipeInputs")
  transfers          StockTransfer[]
  defects          DefectLog[]
  salesOrderItems  SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
}

model Supplier {
  id             Int      @id @default(autoincrement())
  name           String
  shortName      String?
  address        String?
  phone          String?
  email          String?
  certificate    String?
  qaRequirements String?  // e.g. "Tuproq va suv analizi shart"
  auditSchedule  String?  // e.g. "Har yili 1 marta"
  category       String   @default("GENERAL") // GENERAL, PRODUCTION, KITCHEN
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  inspections    Inspection[]
  orders         Order[]
  defects        DefectLog[]
  purchaseOrders PurchaseOrder[]
}

model Inspection {
  id               Int      @id @default(autoincrement())
  actNumber        String   @unique
  inspectionDate   DateTime
  supplierId       Int
  productId        Int
  batchNumber      String
  quantity         Float
  quantityUnit     String   @default("kg")
  temperature      Float?
  temperatureUnit  String   @default("°C")
  packaging        String?
  color            String?
  smell            String?
  appearance       String?
  conclusion       String   @default("Muvofiq")
  status           String   @default("ACCEPTED") // ACCEPTED, REJECTED, CONDITIONAL
  rating           Int?     // Ta'minotchi reytingi (1-5)
  inspector        String?
  inspectorId      Int?
  supervisorId     Int?     
  vehicleNumber    String?
  invoiceNumber    String?
  notes            String?
  customFields     String?  // JSON for dynamic fields
  excelPath        String?
  pdfPath          String?
  sheetName        String?  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  releasedQuantity Float?
  releasedDate     DateTime?
  orderId          Int?

  supplier   Supplier   @relation(fields: [supplierId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
  user       User?      @relation(fields: [inspectorId], references: [id])
  supervisor Supervisor? @relation("InspectorSupervisor", fields: [supervisorId], references: [id])
  order      Order?     @relation(fields: [orderId], references: [id])
  images     ActImage[]

  @@index([inspectionDate])
  @@index([supplierId])
  @@index([productId])
  @@index([actNumber])
}

model Order {
  id                 Int      @id @default(autoincrement())
  productId          Int
  supplierId         Int?
  supplierName       String?  // Qo'lda kiritilgan yoki tezkor yetkazib beruvchi nomi
  quantity           Float
  unit               String?  @default("kg")
  expectedDate       DateTime
  timeRange          String?  // e.g. "08:00 - 13:00"
  actualDeliveryTime DateTime?
  deliveredQuantity  Float?   // Amalda kelgan miqdor (masalan, 92 kg)
  acceptedQuantity   Float?   // Sifat nazorati qabul qilgan miqdor (masalan, 90 kg)
  rejectedQuantity   Float?   // Qaytarilgan miqdor (masalan, 2 kg)
  status             String   @default("PENDING") // PENDING, DELIVERED, PARTIAL, DELAYED, CANCELLED
  imageUrl           String?
  price              Float?   
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product     Product      @relation(fields: [productId], references: [id])
  supplier    Supplier?    @relation(fields: [supplierId], references: [id])
  inspections Inspection[]
}

// -----------------------------------------------------------------------------
// TEXNIK XIZMAT (Maintenance & Ticketing)
// -----------------------------------------------------------------------------

model MaintenanceTicket {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  status       String   @default("OPEN") // OPEN, IN_PROGRESS, WAITING_PARTS, RESOLVED
  equipmentId  String?
  reportedById Int
  assignedToId Int?
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  reportedBy   User     @relation("ReportedTickets", fields: [reportedById], references: [id])
  assignedTo   User?    @relation("AssignedTickets", fields: [assignedToId], references: [id])
}

// -----------------------------------------------------------------------------
// QOLGAN JADVALLAR
// -----------------------------------------------------------------------------

model Supervisor {
  id          Int      @id @default(autoincrement())
  name        String
  position    String?  
  phone       String?
  email       String?
  department  String?  
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inspections Inspection[] @relation("InspectorSupervisor")
}

model Template {
  id          Int      @id @default(autoincrement())
  name        String
  sheetName   String
  filePath    String
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Log {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String?
  entityId  Int?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Backup {
  id        Int      @id @default(autoincrement())
  filename  String
  filePath  String
  sizeBytes Int?
  createdAt DateTime @default(now())
  createdBy String?
}

model ActImage {
  id         Int      @id @default(autoincrement())
  actId      Int
  url        String
  type       String?  
  uploadedAt DateTime @default(now())

  inspection Inspection @relation(fields: [actId], references: [id], onDelete: Cascade)
}

model Specification {
  id          Int      @id @default(autoincrement())
  productId   Int
  fieldName   String
  minVal      Float?
  maxVal      Float?
  stringValue String?
  isCritical  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product  @relation(fields: [productId], references: [id])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  sender    String   
  text      String?  @db.Text
  imageUrl  String?  @db.Text
  groupId   String   @default("general") 
  readBy    String[] @default([]) // Kim ko'rganligini saqlash uchun
  createdAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// SEX SIFAT NAZORATI (Inspector & QA shop floor logs)
// -----------------------------------------------------------------------------

model TemperatureLog {
  id               Int      @id @default(autoincrement())
  date             String   // Sana (YYYY-MM-DD)
  time             String   // Vaqt (masalan: 8-00, 17-00)
  icebergTemp      Float?   // Салат Айсберг (°C)
  onionTemp        Float?   // Лук белый (°C)
  tomatoTemp       Float?   // Томаты (°C)
  carrotTemp       Float?   // Морковь (°C)
  cabbageTemp      Float?   // Капуста белокочанная (°C)
  deviation        String   @default("Норма") // "Норма", "ВНИМАНИЕ: Нарушение"
  correctiveAction String?  // "Отрегулирован хладагент", "-"
  responsible      String   // Иванов И., Петров П.
  inspectorId      Int?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inspector        User?    @relation(fields: [inspectorId], references: [id])

  @@index([date])
}

model ProcessQCLog {
  id                 Int      @id @default(autoincrement())
  dateTime           DateTime @default(now())
  date               String   // YYYY-MM-DD
  time               String   // HH:mm
  cleanZoneTemp      Float?   // Темп-ра Чистой зоны
  dirtyZoneTemp      Float?   // Темп-ра Грязной зоны
  
  // Полуфабрикаты (ПФ) № партии
  pfColeCarrotBatch  String?  // ПФ Коул-слоу Морковь № партии
  pfColeCabbageBatch String?  // ПФ Коул-слоу Капуста № партии
  pfIcebergBatch     String?  // ПФ Айсберг № партии
  pfOnionBatch       String?  // ПФ Лук № партии
  pfTomatoBatch      String?  // ПФ Томат № партии
  
  // Готовая Продукция (ГП) Температура
  gpColeTemp         Float?   // Температура ГП Коул-слоу
  gpIcebergTemp      Float?   // Температура ГП Айсберг
  gpTomatoTemp       Float?   // Температура ГП Томат
  gpOnionTemp        Float?   // Температура ГП Лук
  
  correctiveAction   String?  // Корректирующие действия
  responsible        String?  // Mas'ul shaxs (FIO)
  inspectorId        Int?
  status             String   @default("APPROVED") // APPROVED, ATTENTION, REJECTED
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  inspector          User?    @relation(fields: [inspectorId], references: [id])

  @@index([date])
}

// -----------------------------------------------------------------------------
// 1. FSSC 22000 & QADOQLASH NAZORATI (FSSC 22000 QC Checklist)
// -----------------------------------------------------------------------------
model FsscQcLog {
  id              Int      @id @default(autoincrement())
  date            String   // YYYY-MM-DD
  time            String   // HH:mm
  lineName        String   @default("1-Qadoqlash Liniyasi") // "1-Qadoqlash", "2-Qadoqlash"
  productName     String   // "Aysberg 500g", "Koul-slou 300g"
  batchNumber     String   // Tayyor partiya kodi
  nominalWeight   Float    // Nominal vazn (masalan 500g)
  actualWeight    Float    // Haqiqiy o'lchangan vazn (masalan 504g)
  weightDeviation Float    // Og'ish (masalan +4g, ruxsat etilgan: +-10g)
  packageCheckNo  Int      @default(5) // Har 5-paket tekshiruvi
  sealIntegrityOk Boolean  @default(true) // Germetik payvand sifati
  metalDetectorOk Boolean  @default(true) // Metall detektor nazorati (Fe/Non-Fe/SS)
  labelCorrectOk  Boolean  @default(true) // Etiketka va sana to'g'riligi
  gasMixLevel     String?  // MAP gaz muhiti (O2 / CO2)
  status          String   @default("APPROVED") // APPROVED, WARNING, REJECTED
  correctiveAction String?
  responsible     String
  inspectorId     Int?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inspector       User?    @relation(fields: [inspectorId], references: [id])

  @@index([date])
}

// -----------------------------------------------------------------------------
// 2. KKT-1 (CCP-1) DEZINFEKSIYA ERITMASI NAZORATI (Чек лист дезраствора)
// -----------------------------------------------------------------------------
model DisinfectionLog {
  id               Int      @id @default(autoincrement())
  date             String   // YYYY-MM-DD
  time             String   // HH:mm
  vannaNumber      String   // "1-Vanna (Yuvish)", "2-Vanna (Dezinfeksiya)", "3-Vanna (Chayish)"
  solutionType     String   @default("Xlor eritmasi") // "Xlor eritmasi", "Ozonlangan suv", "Perasetik kislota"
  concentrationPpm Float    // Konsentratsiya (ppm): Masalan 50 - 100 ppm
  phLevel          Float?   // pH darajasi: 6.5 - 7.5
  waterTemp        Float?   // Suv harorati: +2C...+6C
  isStandard       Boolean  @default(true) // Me'yordami?
  correctiveAction String?  // "Xlor konsentrati qo'shildi", "Suv almashtirildi"
  responsible      String
  inspectorId      Int?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inspector        User?    @relation(fields: [inspectorId], references: [id])

  @@index([date])
}

// -----------------------------------------------------------------------------
// 3. KALIBROVKA VA HAR SOATLIK O'LCHOV (Чек лист калибровки)
// -----------------------------------------------------------------------------
model CalibrationLog {
  id               Int      @id @default(autoincrement())
  date             String   // YYYY-MM-DD
  time             String   // HH:mm
  productName      String   // "Айсберг", "Коул-слоу", "Морковь", "Капуста"
  batchNumber      String?  // Xomashyo partiya raqami
  diameterMm       Float?   // Kesim o'lchami / Diametri (Ø mm)
  sampleTemp       Float?   // Mahsulot harorati (0°C - +5°C)
  bladeSharpness   String?  @default("A'lo") // Pichoq o'tkirligi / kesim sifati
  wastePercent     Float?   // Chiqindi / Tozalash isrofi %
  isStandard       Boolean  @default(true)
  correctiveAction String?
  responsible      String
  inspectorId      Int?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inspector        User?    @relation(fields: [inspectorId], references: [id])

  @@index([date])
}

// -----------------------------------------------------------------------------
// 7. XOMASHYONI QABUL QILISH JURNALI (Журнал приемки входного сырья)
// -----------------------------------------------------------------------------
model ReceivingLog {
  id                Int      @id @default(autoincrement())
  docNumber         String   @unique
  date              String   // YYYY-MM-DD
  time              String   // HH:mm
  supplierName      String
  productName       String
  batchNumber       String
  quantityKg        Float
  vehicleNumber     String?  // Mashina davlat raqami
  vehicleCleanOk    Boolean  @default(true) // Transport tozaligi va sanitariyasi
  cargoTemp         Float?   // Yuk/kuzov harorati (°C)
  hasLabCertificate Boolean  @default(true) // Fitosanitariya / Lab sertifikati
  organolepticScore Int?     @default(5) // Organoleptik baho (1-5)
  status            String   @default("ACCEPTED") // ACCEPTED, CONDITIONAL, REJECTED
  rejectReason      String?
  responsible       String
  inspectorId       Int?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  inspector         User?    @relation(fields: [inspectorId], references: [id])

  @@index([date])
}

// -----------------------------------------------------------------------------
// FAZA 4: SOTUV VA MIJOZLAR (SALES & CRM)
// -----------------------------------------------------------------------------

model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String?
  email       String?
  address     String?
  companyName String?
  inn         String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, LEAD
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      SalesOrder[]
  invoices    Invoice[]
  activities  CrmActivity[]
}

model SalesOrder {
  id             Int      @id @default(autoincrement())
  orderNumber    String   @unique
  customerId     Int
  status         String   @default("DRAFT") // DRAFT, CONFIRMED, SHIPPED, DELIVERED, CANCELLED
  totalAmount    Float    @default(0)
  currency       String   @default("UZS")
  orderDate      DateTime @default(now())
  deliveryDate   DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer       Customer          @relation(fields: [customerId], references: [id])
  items          SalesOrderItem[]
  invoices       Invoice[]
}

model SalesOrderItem {
  id           Int      @id @default(autoincrement())
  salesOrderId Int
  productId    Int
  quantity     Float
  unitPrice    Float
  totalPrice   Float
  discount     Float?   @default(0)

  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])
}

model CrmActivity {
  id          Int      @id @default(autoincrement())
  customerId  Int
  type        String   // CALL, MEETING, EMAIL, NOTE
  description String
  date        DateTime @default(now())
  userId      Int?
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// FAZA 5: XARID (PROCUREMENT) - Purchase Orders
// -----------------------------------------------------------------------------

model PurchaseOrder {
  id             Int      @id @default(autoincrement())
  poNumber       String   @unique
  supplierId     Int
  status         String   @default("DRAFT") // DRAFT, ORDERED, RECEIVED, CANCELLED
  totalAmount    Float    @default(0)
  currency       String   @default("UZS")
  orderDate      DateTime @default(now())
  expectedDate   DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  items          PurchaseOrderItem[]
  invoices       Invoice[]
}

model PurchaseOrderItem {
  id              Int      @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int
  quantity        Float
  unitPrice       Float
  totalPrice      Float

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])
}

// -----------------------------------------------------------------------------
// FAZA 6: MOLIYA VA BUXGALTERIYA (FINANCE)
// -----------------------------------------------------------------------------

model Invoice {
  id              Int      @id @default(autoincrement())
  invoiceNumber   String   @unique
  type            String   // SALES_INVOICE, PURCHASE_INVOICE
  status          String   @default("UNPAID") // UNPAID, PARTIAL, PAID, CANCELLED
  totalAmount     Float
  paidAmount      Float    @default(0)
  dueDate         DateTime?
  issuedDate      DateTime @default(now())
  
  salesOrderId    Int?
  purchaseOrderId Int?
  customerId      Int?

  salesOrder      SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  customer        Customer?      @relation(fields: [customerId], references: [id])
  transactions    Transaction[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BankAccount {
  id            Int      @id @default(autoincrement())
  name          String   // e.g. Asosiy Hisob, Kassa
  accountNumber String?
  currency      String   @default("UZS")
  balance       Float    @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions  Transaction[]
}

model Transaction {
  id              Int      @id @default(autoincrement())
  type            String   // INCOME, EXPENSE, TRANSFER
  amount          Float
  date            DateTime @default(now())
  description     String?
  category        String?  // e.g. SALARY, RAW_MATERIALS, UTILITIES
  
  bankAccountId   Int
  invoiceId       Int?
  userId          Int?     // Who recorded it

  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id])
  invoice         Invoice?    @relation(fields: [invoiceId], references: [id])
  
  createdAt       DateTime @default(now())
}

// -----------------------------------------------------------------------------
// FAZA 7: XODIMLAR (HR)
// -----------------------------------------------------------------------------

model Employee {
  id             Int      @id @default(autoincrement())
  userId         Int?     @unique // If employee has system login
  firstName      String
  lastName       String
  position       String
  departmentId   Int?
  hireDate       DateTime
  salaryBase     Float    @default(0)
  status         String   @default("ACTIVE") // ACTIVE, ON_LEAVE, TERMINATED
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attendances    Attendance[]
  payrolls       Payroll[]
}

model Attendance {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  date        DateTime @default(now())
  status      String   // PRESENT, ABSENT, LATE, SICK_LEAVE, VACATION
  checkIn     DateTime?
  checkOut    DateTime?
  notes       String?

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Payroll {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  periodMonth   Int
  periodYear    Int
  baseSalary    Float
  bonuses       Float    @default(0)
  deductions    Float    @default(0)
  netPay        Float
  status        String   @default("DRAFT") // DRAFT, APPROVED, PAID
  paymentDate   DateTime?

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// 8. YAGONA KUNLIK CHECK-LIST (Daily QC Checklist - Smena Yakuni)
// -----------------------------------------------------------------------------
model DailyQCChecklist {
  id             Int      @id @default(autoincrement())
  date           String   // YYYY-MM-DD
  shift          String
  lineName       String?
  batchNumber    String?
  rejectedKg     Float?
  totalOutputBox Float?
  supervisor     String?
  inspector      String?
  inspectorId    Int?
  
  formData       String   @db.Text // JSON string of the entire checklist data
  status         String   @default("COMPLETED")
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User?    @relation(fields: [inspectorId], references: [id])
}

// -----------------------------------------------------------------------------
// 9. TAYYOR MAHSULOTNI JO'NATISH JURNALI (Shipping Log)
// -----------------------------------------------------------------------------
model ShippingLog {
  id               Int      @id @default(autoincrement())
  date             String   // YYYY-MM-DD
  time             String   // HH:mm
  productName      String
  weight           Float
  tempReceived     String?
  tempStorage      String?
  companyAndDriver String?
  carCondition     String?
  tempLoaded       String?
  timeLoaded       String?
  receiverName     String?
  senderName       String?
  correctiveAction String?
  createdAt        DateTime @default(now())
}

// -----------------------------------------------------------------------------
// 10. DINAMIK JADVAL MENEJERI (Custom Excel Templates)
// -----------------------------------------------------------------------------
model CustomTemplate {
  id          Int      @id @default(autoincrement())
  name        String                          // Jadval nomi
  description String?                         // Qisqacha tavsif
  columns     String   @db.Text              // JSON: [{key, label, type}]
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  records     CustomRecord[]
}

model CustomRecord {
  id         Int      @id @default(autoincrement())
  templateId Int
  data       String   @db.Text              // JSON: {col1: val1, col2: val2 ...}
  createdBy  String?
  createdAt  DateTime @default(now())

  template   CustomTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}
